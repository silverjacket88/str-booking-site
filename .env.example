# Copy to .env.local and fill in when you're ready to go live on OwnerRez.
# Leave PMS_PROVIDER unset (or "mock") to keep using sample data.

PMS_PROVIDER=mock

# From OwnerRez: Settings -> Developer / API Settings -> Personal Access
# Tokens -> Generate New Token. Auth is HTTP Basic using these two values
# (your account email as username, the token as password) — not a
# separate "API key."
OWNERREZ_ACCOUNT_EMAIL=
OWNERREZ_PERSONAL_ACCESS_TOKEN=
